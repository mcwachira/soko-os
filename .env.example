# Application
APP_NAME=Soko-OS
APP_ENV=local
APP_KEY=base64:c29rb29zLW1hc3Rlci1kZXYta2V5LTIwMjYxMj09
APP_DEBUG=true
APP_URL=http://localhost:8080

# Host-published ports (Docker)
NGINX_HTTP_PORT=8080
WEB_PORT=3001
POSTGRES_PORT=5437
REDIS_PORT=6382
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# Database (inside Docker network use host=postgres, port=5432)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5437
DB_DATABASE=soko_os
DB_USERNAME=soko
DB_PASSWORD=sokosecret

# Redis (host access)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
# Host-mapped Redis port; containers use 6379 internally
# REDIS_PORT above is the published host port

# Mail (Mailpit) — host access
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@soko-os.africa"
MAIL_FROM_NAME="Soko-OS"

# MinIO / S3 — host access
MINIO_ROOT_USER=sokominio
MINIO_ROOT_PASSWORD=sokominiosecret
AWS_ACCESS_KEY_ID=sokominio
AWS_SECRET_ACCESS_KEY=sokominiosecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=soko-storage
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9002

# Kenya KRA eTIMS — Requires Credentials / Sandbox / Certification
KRA_MODE=sandbox
KRA_BASE_URL=https://etims-sbx.kra.go.ke
KRA_PIN=
KRA_CLIENT_ID=
KRA_CLIENT_SECRET=

# Mobile money — placeholders only; adapters require provider credentials
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Accounting providers — placeholders; adapters require OAuth credentials
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Observability (optional)
SENTRY_DSN=
